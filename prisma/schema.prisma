generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
  PURCHASER
  COURIER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CourierStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  NEW
  ASSIGNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum MovementType {
  TRANSFER_TO_COURIER
  ORDER_SALE
  ORDER_RETURN
  RETURN_TO_CENTRAL
  ADJUSTMENT
  DOCUMENT_RECEIPT
  DOCUMENT_TRANSFER
  DOCUMENT_RETURN
  DOCUMENT_WRITE_OFF
  DOCUMENT_SALE
  DOCUMENT_INVENTORY
  DOCUMENT_ADJUSTMENT
}

enum WarehouseType {
  CENTRAL
  COURIER
}

enum DocumentType {
  RECEIPT
  TRANSFER
  RETURN
  WRITE_OFF
  SALE
  INVENTORY
  ADJUSTMENT
}

enum DocumentStatus {
  DRAFT
  REVIEW
  POSTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum MatchConfidence {
  EXACT
  PROBABLE
  UNMATCHED
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  login          String        @unique
  passwordHash   String
  role           Role
  name           String
  phone          String?
  telegram       String?
  courierStatus  CourierStatus @default(ACTIVE)
  isOnline       Boolean       @default(false)
  lastSeenAt     DateTime?
  qrToken        String?       @unique
  telegramChatId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  courierOrders      Order[]           @relation("CourierOrders")
  stockItems         CourierStock[]
  movementsFrom      StockMovement[]   @relation("MovementFrom")
  movementsTo        StockMovement[]   @relation("MovementTo")
  locations          CourierLocation[]
  auditLogs          AuditLog[]        @relation("AuditAdmin")
  auditAsCourier     AuditLog[]        @relation("AuditCourier")
  movementsCreated   StockMovement[]   @relation("MovementCreatedBy")
  warehouse          Warehouse?        @relation("CourierWarehouse")
  documentsAuthored  StockDocument[]   @relation("DocAuthor")
  documentsPosted    StockDocument[]   @relation("DocPostedBy")
  documentsPurchased StockDocument[]   @relation("DocPurchaser")
  aliasesConfirmed   ReceiptProductAlias[] @relation("AliasConfirmedBy")
  advancesReceived   PurchaserAdvance[] @relation("AdvancePurchaser")
  advancesIssued     PurchaserAdvance[] @relation("AdvanceIssuer")
  activityLogs       ActivityLog[]

  @@index([phone])
  @@index([telegram])
  @@index([role])
}

// ─── Warehouses ──────────────────────────────────────────────────────────────

model Warehouse {
  id        String        @id @default(cuid())
  name      String
  type      WarehouseType
  courierId String?       @unique
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  courier       User?            @relation("CourierWarehouse", fields: [courierId], references: [id])
  stock         WarehouseStock[]
  documentsFrom StockDocument[]  @relation("DocFromWarehouse")
  documentsTo   StockDocument[]  @relation("DocToWarehouse")
  movements     StockMovement[]  @relation("MovementWarehouse")

  @@index([type])
}

model WarehouseStock {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id                String        @id @default(cuid())
  name              String
  brand             String?
  category          String
  volume            String?
  unit              String        @default("шт")
  abv               Decimal?      @db.Decimal(5, 2)
  article           String?
  sku               String?       @unique
  barcode           String?
  purchasePrice     Decimal       @db.Decimal(12, 2)
  avgPurchasePrice  Decimal       @db.Decimal(12, 2) @default(0)
  salePrice         Decimal       @db.Decimal(12, 2)
  minStock          Int           @default(0)
  centralStock      Int           @default(0)
  lastSupplierId    String?
  imageUrl          String?
  status            ProductStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lastSupplier     Supplier?            @relation(fields: [lastSupplierId], references: [id])
  barcodes         ProductBarcode[]
  courierStock     CourierStock[]
  warehouseStock   WarehouseStock[]
  orderItems       OrderItem[]
  movements        StockMovement[]
  auditLogs        AuditLog[]
  documentLines    StockDocumentLine[]
  receiptAliases   ReceiptProductAlias[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([sku])
  @@index([article])
  @@index([barcode])
  @@index([brand])
}

model ProductBarcode {
  id        String   @id @default(cuid())
  productId String
  barcode   String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Suppliers ───────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  inn       String?
  address   String?
  phone     String?
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  documents StockDocument[]
  aliases   ReceiptProductAlias[]

  @@index([name])
  @@index([inn])
}

// ─── Stock Documents ─────────────────────────────────────────────────────────

model StockDocument {
  id                String         @id @default(cuid())
  number            Int            @unique @default(autoincrement())
  type              DocumentType
  status            DocumentStatus @default(DRAFT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  postedAt          DateTime?
  purchaseDate      DateTime?
  authorId          String
  postedById        String?
  purchaserId       String?
  fromWarehouseId   String?
  toWarehouseId     String?
  supplierId        String?
  comment           String?
  totalPurchaseCost Decimal?       @db.Decimal(12, 2)
  receiptNumber     String?
  receiptTotal      Decimal?       @db.Decimal(12, 2)
  linesTotal        Decimal?       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod?
  discrepancyReason String?
  orderId           String?

  author        User                  @relation("DocAuthor", fields: [authorId], references: [id])
  postedBy      User?                 @relation("DocPostedBy", fields: [postedById], references: [id])
  purchaser     User?                 @relation("DocPurchaser", fields: [purchaserId], references: [id])
  fromWarehouse Warehouse?            @relation("DocFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?            @relation("DocToWarehouse", fields: [toWarehouseId], references: [id])
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  order         Order?                @relation(fields: [orderId], references: [id])
  lines         StockDocumentLine[]
  attachments   DocumentAttachment[]
  changeLogs    DocumentChangeLog[]
  ocrResults    ReceiptOcrResult[]
  movements     StockMovement[]

  @@index([type])
  @@index([status])
  @@index([authorId])
  @@index([purchaserId])
  @@index([createdAt])
  @@index([supplierId, receiptNumber])
}

model StockDocumentLine {
  id              String           @id @default(cuid())
  documentId      String
  productId       String?
  quantity        Int
  purchasePrice   Decimal?         @db.Decimal(12, 2)
  salePrice       Decimal?         @db.Decimal(12, 2)
  lineTotal       Decimal?         @db.Decimal(12, 2)
  excluded        Boolean          @default(false)
  receiptLineText String?
  matchConfidence MatchConfidence?

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id])

  @@index([documentId])
  @@index([productId])
}

model DocumentAttachment {
  id         String   @id @default(cuid())
  documentId String
  fileName   String
  fileUrl    String
  mimeType   String
  pageNumber Int?
  createdAt  DateTime @default(now())

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentChangeLog {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  action     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([createdAt])
}

model ReceiptOcrResult {
  id           String   @id @default(cuid())
  documentId   String
  rawJson      String
  storeName    String?
  inn          String?
  receiptDate  DateTime?
  receiptTime  String?
  receiptNumber String?
  totalAmount  Decimal? @db.Decimal(12, 2)
  discount     Decimal? @db.Decimal(12, 2)
  processedAt  DateTime @default(now())

  document StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ReceiptProductAlias {
  id             String   @id @default(cuid())
  receiptText    String
  normalizedText String
  productId      String
  supplierId     String?
  confirmCount   Int      @default(1)
  lastUsedAt     DateTime @default(now())
  confirmedById  String?

  product     Product   @relation(fields: [productId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  confirmedBy User?     @relation("AliasConfirmedBy", fields: [confirmedById], references: [id])

  @@index([normalizedText])
  @@index([supplierId, normalizedText])
}

model PurchaserAdvance {
  id            String        @id @default(cuid())
  purchaserId   String
  amount        Decimal       @db.Decimal(12, 2)
  issuedAt      DateTime      @default(now())
  paymentMethod PaymentMethod
  comment       String?
  issuedById    String

  purchaser User @relation("AdvancePurchaser", fields: [purchaserId], references: [id])
  issuedBy  User @relation("AdvanceIssuer", fields: [issuedById], references: [id])

  @@index([purchaserId])
  @@index([issuedAt])
}

// ─── Legacy stock (synced from WarehouseStock) ───────────────────────────────

model CourierStock {
  id        String   @id @default(cuid())
  courierId String
  productId String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  courier User    @relation(fields: [courierId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([courierId, productId])
  @@index([courierId])
}

model StockMovement {
  id            String       @id @default(cuid())
  type          MovementType
  productId     String
  quantity      Int
  fromCourierId String?
  toCourierId   String?
  orderId       String?
  documentId    String?
  warehouseId   String?
  note          String?
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())

  product     Product        @relation(fields: [productId], references: [id])
  fromCourier User?          @relation("MovementFrom", fields: [fromCourierId], references: [id])
  toCourier   User?          @relation("MovementTo", fields: [toCourierId], references: [id])
  order       Order?         @relation(fields: [orderId], references: [id])
  document    StockDocument? @relation(fields: [documentId], references: [id])
  warehouse   Warehouse?     @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  createdBy   User?          @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([type])
  @@index([deletedAt])
  @@index([documentId])
}

// ─── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  adminId   String
  courierId String?
  productId String?
  quantity  Int?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  admin   User     @relation("AuditAdmin", fields: [adminId], references: [id])
  courier User?    @relation("AuditCourier", fields: [courierId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  userRole   Role
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Orders (unchanged logic) ────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique @default(autoincrement())
  clientName  String
  clientPhone String
  address     String
  comment     String?
  status      OrderStatus @default(NEW)
  totalAmount Decimal     @db.Decimal(12, 2) @default(0)
  courierId   String?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  courier   User?           @relation("CourierOrders", fields: [courierId], references: [id])
  items     OrderItem[]
  movements StockMovement[]
  documents StockDocument[]

  @@index([status])
  @@index([courierId])
  @@index([createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  salePrice     Decimal @db.Decimal(12, 2)
  purchasePrice Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model CourierLocation {
  id        String   @id @default(cuid())
  courierId String
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())

  courier User @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}
